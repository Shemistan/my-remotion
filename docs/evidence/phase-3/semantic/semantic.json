      "id": "ch_01",
      "title": "Обработка ошибок соединения",
      "summary": "Фатальные ошибки закрывают соединение, нефатальные получают ответ с request id и работа продолжается.",
      "start_word_id": "w_000001",
      "end_word_id": "w_000092"
    },
    {
      "id": "ch_02",
      "title": "Неизвестный тип сообщения",
      "summary": "Получатель пропускает неизвестное сообщение по длине и дочитывает его до конца.",
      "start_word_id": "w_000093",
      "end_word_id": "w_000138"
    },
    {
      "id": "ch_03",
      "title": "Sequence diagram всего обмена",
      "summary": "Пошаговый разбор общения сервисов от TCP-рукопожатия до закрытия соединения.",
      "start_word_id": "w_000149",
      "end_word_id": "w_000322"
    },
    {
      "id": "ch_04",
      "title": "Обратная совместимость протокола",
      "summary": "Правила изменения версии, полей и новых фич через handshake.",
      "start_word_id": "w_000323",
      "end_word_id": "w_000421"
    }
