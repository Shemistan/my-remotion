      "kind": "card",
      "role": "node: Пользователь — источник запроса",
      "entrance": "slide",
      "depth_layer": 1,
      "content": {
        "label": "Пользователь",
        "caption": "запрос",
        "enter": "slide",
        "enterAt": 8,
        "elevation": 2,
        "size": "body",
        "flash_on": "e-req (back, pulse-answer)"
