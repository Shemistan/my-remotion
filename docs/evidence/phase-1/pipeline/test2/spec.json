{
  "title": "Архитектура AI-агента",
  "purpose": "Показать цикл AI-агента: запрос пользователя идёт в оркестратор, тот вызывает три инструмента, данные возвращаются и ответ уходит пользователю.",
  "duration_frames": 180,
  "fps": {
    "num": 30,
    "den": 1
  },
  "style_preset": "dark-premium",
  "palette_overrides": {},
  "composition": {
    "archetype": "network-centric",
    "idea": "Светящаяся схема на графитовой ауре: Пользователь слева, крупный Оркестратор в центре, три инструмента столбцом справа. Взгляд идёт по импульсу слева к центру, веером вправо, обратно в центр и к пользователю — замкнутый цикл. Фон — Background aurora и Particles слоя 0.",
    "focus": "Камера стоит, фокус ведут импульсы и вспышка узла, к которому пришёл импульс; итог — дышащая плашка «Ответ готов».",
    "transitions": "Схема собирается каскадом разных входов, рёбра прорисовываются; четыре фазы импульсов (запрос → вызовы → возврат → ответ) передают акцент от узла к узлу; финал — потоки стихли, дышит результат."
  },
  "elements": [
    {
      "id": "kicker",
      "kind": "text",
      "role": "контекст: тема сцены",
      "entrance": "type",
      "depth_layer": 1,
      "content": {
        "component": "KineticText",
        "text": "Архитектура AI-агента",
        "mode": "letters",
        "enter": "type",
        "size": "body",
        "font": "display",
        "color": "muted"
      },
      "layout": {
        "x": 0,
        "y": 0,
        "w": 0.45,
        "h": 0.08
      }
    },
    {
      "id": "agent-graph",
      "kind": "graph",
      "role": "схема: связи агента, по которым идут импульсы",
      "entrance": "draw",
      "depth_layer": 1,
      "content": {
        "component": "FlowGraph",
        "enter": "rise",
        "note": "координаты узлов — из layout узлов (доли safe area → px 1728×972); рёбра S-кривые, прорисовка после прихода обоих узлов",
        "edges": [
          {
            "id": "e-user",
            "from": "user",
            "to": "orchestrator"
          },
          {
            "id": "e-search",
            "from": "orchestrator",
            "to": "tool-search"
          },
          {
            "id": "e-code",
            "from": "orchestrator",
            "to": "tool-code"
          },
          {
            "id": "e-db",
            "from": "orchestrator",
            "to": "tool-db"
          }
        ],
        "flows": [
          {
            "edge": "e-user",
            "direction": "forward",
            "beat": "pulse-request"
          },
          {
            "edge": "e-search",
            "direction": "forward",
            "beat": "pulse-fan-out"
          },
          {
            "edge": "e-code",
            "direction": "forward",
            "beat": "pulse-fan-out"
          },
          {
            "edge": "e-db",
            "direction": "forward",
            "beat": "pulse-fan-out"
          },
          {
            "edge": "e-search",
            "direction": "back",
            "beat": "pulse-return"
          },
          {
            "edge": "e-code",
            "direction": "back",
            "beat": "pulse-return"
          },
          {
            "edge": "e-db",
            "direction": "back",
            "beat": "pulse-return"
          },
          {
            "edge": "e-user",
            "direction": "back",
            "beat": "pulse-reply"
          }
        ],
        "pulses": {
          "component": "PulseAlongPath",
          "travel": 20,
          "repeat": false,
          "count": 1,
          "colors": {
            "pulse-request": "accent[0]",
            "pulse-fan-out": "accent[1]",
            "pulse-return": "accent[2]",
            "pulse-reply": "accent[0]"
          }
        }
      },
      "layout": {
        "x": 0,
        "y": 0.1,
        "w": 1,
        "h": 0.9
      }
    },
