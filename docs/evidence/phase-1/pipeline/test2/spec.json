      "entrance": "rise",
      "depth_layer": 1,
      "content": {
        "label": "Веб-поиск",
        "caption": "инструмент",
        "enter": "rise",
        "enterAt": 30,
        "elevation": 2,
        "size": "body",
        "flash_on": "e-t1 (forward, pulse-fan-out)"
      },
      "layout": {
        "x": 0.74,
        "y": 0.17,
