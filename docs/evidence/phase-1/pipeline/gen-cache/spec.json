      "layout": {
        "x": 0.05,
        "y": 0.36,
        "w": 0.2,
        "h": 0.22
      }
    },
    {
      "id": "node-cache",
      "kind": "card",
      "role": "node: кэш — герой сцены",
      "entrance": "pop",
      "depth_layer": 1,
