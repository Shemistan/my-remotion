      "content": {
        "component": "KineticText enter=fade mode=words",
        "text": "Промах — долгий путь · Попадание — сразу",
        "size": "body",
        "align": "center",
        "color": "muted",
        "highlight": [
          "сразу"
        ]
      },
      "layout": {
        "x": 0.15,
        "y": 0.86,
        "w": 0.7,
        "h": 0.09
      }
    }
  ],
