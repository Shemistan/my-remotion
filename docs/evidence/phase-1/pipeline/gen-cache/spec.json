      "role": "контекст: состояние кэша, меняется на месте",
      "entrance": "pop",
      "depth_layer": 1,
      "content": {
        "component": "Enter (смена слов на месте через exit)",
        "size": "h1",
        "align": "center",
        "states": [
          {
            "text": "Запрос",
            "from_frame": 40,
            "to_frame": 56,
            "color": "muted",
            "enter": "type"
          },
          {
            "text": "Промах",
            "from_frame": 56,
            "to_frame": 92,
            "color": "negative",
            "enter": "pop"
          },
          {
            "text": "Запись",
            "from_frame": 94,
            "to_frame": 122,
            "color": "accent[2]",
            "enter": "rise"
          },
          {
            "text": "Попадание",
            "from_frame": 126,
            "to_frame": 180,
            "color": "positive",
            "enter": "pop"
          }
        ],
        "note": "каждое предыдущее слово уходит exit fade за exit_frames=14 до входа следующего; в кадре всегда одно слово, перекрытия нет"
      },
      "layout": {
        "x": 0.33,
        "y": 0.18,
        "w": 0.34,
        "h": 0.12
      }
    },
    {
      "id": "cache-flow",
      "kind": "graph",
      "role": "структура: клиент → кэш → база данных",
      "entrance": "draw",
      "depth_layer": 1,
      "content": {
        "component": "FlowGraph + PulseAlongPath",
        "enter": "flip",
        "nodes": [
          "node-client",
          "node-cache",
          "node-db"
        ],
        "edges": [
          {
            "id": "e-req",
            "from": "node-client",
            "to": "node-cache"
          },
          {
            "id": "e-db",
            "from": "node-cache",
            "to": "node-db"
          }
        ],
        "travel": 16,
        "flows": [
          {
            "edge": "e-req",
            "direction": "forward",
            "beat": "request-1",
            "color": "accent[0]"
          },
          {
            "edge": "e-db",
            "direction": "forward",
            "beat": "miss-to-db",
            "color": "accent[0]"
          },
          {
            "edge": "e-db",
            "direction": "back",
            "beat": "db-return-write",
            "color": "accent[2]"
          },
          {
            "edge": "e-req",
            "direction": "back",
            "beat": "answer-1",
            "color": "accent[2]"
          },
          {
            "edge": "e-req",
            "direction": "forward",
            "beat": "request-2",
            "color": "accent[0]"
          },
          {
            "edge": "e-req",
            "direction": "back",
            "beat": "hit-return",
            "color": "accent[1]"
          }
        ],
        "pulse_params": {
          "count": 1,
          "repeat": false,
          "tail": 120,
          "size": 7
        }
      },
      "layout": {
        "x": 0,
        "y": 0.34,
        "w": 1,
        "h": 0.48
