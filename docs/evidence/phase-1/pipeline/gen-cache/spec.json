    },
    {
      "id": "cache-slot",
      "kind": "card",
      "role": "ячейка кэша внутри узла Кэш: пусто → данные",
      "entrance": "pop",
      "depth_layer": 1,
      "content": {
        "component": "Card elevation 1 внутри node-cache",
        "empty_state": "пунктирная рамка muted с текстом «пусто» (caption, muted) — видна с входа кэша",
        "filled_label": "данные",
        "size": "body",
        "enter": "pop",
        "fill_at": "кадр прихода обратного импульса: pulseArrival('e-fetch', b-write-return, 22, { repeat: false }) — ячейка выскакивает заполненной, кромка accent[1]",
        "nested_in": "node-cache"
      },
      "layout": {
        "x": 0.41,
        "y": 0.47,
        "w": 0.18,
        "h": 0.12
      }
    },
    {
