        "size": "h2",
        "elevation": 3,
        "enter": "pop",
        "enterAt": 16,
        "accentIndex": 0,
        "slot": {
          "empty_text": "пусто",
          "filled_text": "user:42",
          "fill_at_frame": 94,
          "note": "внутри узла — ячейка-строка caption/body: до кадра 94 пунктир и приглушённое «пусто», в кадр прихода обратного импульса по e-db содержимое меняется на «user:42» (rise внутри ячейки, кромка accent[2])"
        },
        "flash_on": [
          "e-req@request-1",
          "e-db@db-return-write",
          "e-req@request-2"
        ],
        "flash_note": "flash: pulseArrival для трёх импульсов (repeat:false, travel 16): промах 56, запись 94, попадание 126",
