      "depth_layer": 2,
      "content": {
        "component": "Card",
        "elevation": 1,
        "empty_text": "пусто",
        "filled_text": "user:42 ✓",
        "size": "body",
        "empty_color": "muted",
        "filled_border": "positive",
        "fill_on": "arrival e-fetch back (b-write)",
        "fill_transition": "«пусто» уходит <Enter exit kind=fade>, «user:42 ✓» входит pop в кадр прихода обратного импульса; кромка ячейки становится positive и остаётся"
      },
      "layout": {
        "x": 0.395,
        "y": 0.46,
        "w": 0.21,
        "h": 0.17
      }
    },
    {
      "id": "node-source",
      "kind": "card",
      "role": "node: источник данных — медленный",
      "entrance": "blur",
      "depth_layer": 1,
      "content": {
        "label": "Источник",
        "caption": "медленно",
        "enter": "blur",
        "enterAt": 22,
        "elevation": 1,
        "accentIndex": 0,
        "flash_on": "e-fetch (forward, b-miss)",
        "dim_from": "b-hit-request: opacity → 0.4, остаётся тёмным до конца"
      },
      "layout": {
        "x": 0.71,
        "y": 0.36,
        "w": 0.24,
        "h": 0.22
      }
    },
    {
      "id": "step-tracker",
      "kind": "group",
      "role": "шаги процесса: текущая фаза",
      "entrance": "slide",
      "depth_layer": 1,
      "content": {
        "items": [
          "Запрос",
          "Промах",
          "Запись",
          "Попадание"
        ],
        "size": "body",
        "layout": "4 равные колонки, разделитель — тонкая точка muted",
        "enter": "Enter slide каскадом index/total, stagger 4",
        "states": {
          "pending": "muted, opacity 0.5",
          "active": "text, под словом тонкая полоса цвета text",
          "done": "muted"
        },
        "special": {
          "Промах": "в активной фазе цвет negative",
          "Попадание": "акцент финала: Emphasis loop, accentIndex 0, ring false, shape pill"
        },
        "activation": {
          "Запрос": "b-request",
          "Промах": "b-miss",
          "Запись": "b-write",
          "Попадание": "b-hit-request"
        }
      },
      "layout": {
        "x": 0.08,
        "y": 0.82,
        "w": 0.84,
        "h": 0.1
      }
    }
  ],
