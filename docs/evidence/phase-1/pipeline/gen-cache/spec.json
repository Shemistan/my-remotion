        "label": "Кэш",
        "size": "h2",
        "enter": "pop",
        "enterAt": 14,
        "elevation": 3,
        "accentIndex": 0,
        "flash_on": [
          "e-req (forward, b-request) — промах",
          "e-req (forward, b-hit-request) — попадание"
        ],
        "note": "подпись вверху узла; нижняя половина — место под ячейку cache-slot"
      },
      "layout": {
        "x": 0.37,
        "y": 0.24,
        "w": 0.26,
        "h": 0.46
      }
    },
    {
      "id": "cache-slot",
      "kind": "card",
      "role": "ячейка кэша внутри узла",
