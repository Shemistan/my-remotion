#!/bin/sh
# Цикл качества по запросу: ./quality-loop [--dry-run] [--smoke] [--until ЧЧ:ММ|ISO | --hours N]
#   [--resume] [--run КЛЮЧ] [--item Q07] [--budget-usd 150] … — подробно: app/motion-studio/scripts/NIGHT.md.
# Нужен MS_DATA_DIR (хранилище на внешнем SSD), например:
#   export MS_DATA_DIR="/Volumes/External SSD/moution-studio-materials/store"
cd "$(dirname "$0")/app/motion-studio" || exit 1
for a in "$@"; do
  case "$a" in
    # nvm exec перехватывает --help — справка прямо из шапки скрипта
    --help|-h) sed -n 's#^// \{0,1\}##p;/^import/q' scripts/night.mts | sed '/^import/d'; exit 0 ;;
  esac
done
exec ./scripts/with-node.sh npx tsx scripts/night.mts "$@"
