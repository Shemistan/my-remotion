      "kind": "text",
      "role": "контекст: тема сцены",
      "entrance": "type",
      "depth_layer": 1,
      "content": {
        "component": "KineticText",
        "text": "Как работает кэширование",
        "size": "body",
        "font": "body",
        "mode": "letters",
        "enter": "type",
        "align": "center",
        "color": "muted"
      },
      "layout": {
        "x": 0.2,
        "y": 0.03,
        "w": 0.6,
        "h": 0.09
      }
    },
    {
      "id": "cache-flow",
      "kind": "graph",
      "role": "опора: схема клиент → кэш → база",
      "entrance": "draw",
      "depth_layer": 1,
      "content": {
        "component": "FlowGraph",
        "enter": "flip",
        "edges": [
          {
            "id": "e-req",
            "from": "node-client",
            "to": "node-cache"
          },
          {
            "id": "e-miss",
            "from": "node-cache",
            "to": "node-db"
          }
        ],
        "flows": [
          {
            "edge": "e-req",
            "direction": "forward",
            "beat": "b-request-1"
          },
          {
            "edge": "e-miss",
            "direction": "forward",
            "beat": "b-miss-to-db"
          },
          {
            "edge": "e-miss",
            "direction": "back",
            "beat": "b-db-return"
          },
          {
            "edge": "e-req",
            "direction": "forward",
            "beat": "b-request-2"
          },
          {
            "edge": "e-req",
            "direction": "back",
            "beat": "b-hit-return"
          }
        ],
        "pulse": {
          "travel": 16,
          "repeat": false,
          "count": 1
