{
  "title": "Кэш: промах и попадание",
  "purpose": "Показать, что первый запрос идёт к базе и записывается в кэш, а повторный сразу возвращается из кэша.",
  "duration_frames": 180,
  "fps": {
    "num": 30,
    "den": 1
  },
  "style_preset": "dark-premium",
  "elements": [
    {
