            "travel": 22
          },
          {
            "edge": "e-orch-code",
            "direction": "forward",
            "beat": "b-tool-calls",
            "color": "accent[2]",
            "count": 1,
            "repeat": false,
            "travel": 22
          },
          {
            "edge": "e-orch-search",
            "direction": "back",
            "beat": "b-data-return",
            "color": "accent[0]",
            "count": 1,
            "repeat": false,
            "travel": 22
