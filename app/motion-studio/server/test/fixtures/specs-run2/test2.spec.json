            "from": "node-user",
            "to": "node-orchestrator"
          },
          {
            "id": "e-orch-search",
            "from": "node-orchestrator",
            "to": "node-search"
          },
          {
            "id": "e-orch-db",
            "from": "node-orchestrator",
            "to": "node-db"
          },
          {
            "id": "e-orch-code",
            "from": "node-orchestrator",
            "to": "node-code"
          }
        ],
        "flows": [
          {
            "edge": "e-user-orch",
            "direction": "forward",
            "beat": "b-request",
            "color": "accent[0]",
            "count": 1,
            "repeat": false,
            "travel": 22
          },
          {
            "edge": "e-orch-search",
            "direction": "forward",
            "beat": "b-tool-calls",
            "color": "accent[0]",
            "count": 1,
            "repeat": false,
            "travel": 22
          },
          {
            "edge": "e-orch-db",
            "direction": "forward",
            "beat": "b-tool-calls",
            "color": "accent[1]",
            "count": 1,
