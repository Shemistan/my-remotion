#!/bin/sh
# Запуск AI Motion Studio из корня репозитория: ./studio → http://127.0.0.1:8790
# Хранилище по умолчанию — папка материалов на SSD; своё — через MS_DATA_DIR.
# Первый запуск ставит зависимости и собирает UI (make install web-build), дальше — быстро.
set -e
cd "$(dirname "$0")/app/motion-studio" || exit 1
: "${MS_DATA_DIR:=/Volumes/External SSD/moution-studio-materials/store}"
export MS_DATA_DIR
if [ ! -d "$MS_DATA_DIR" ]; then
  echo "Хранилище не найдено: $MS_DATA_DIR — подключите SSD (на системный диск не пишем)." >&2
  exit 1
fi
make -s install web-build
exec ./scripts/with-node.sh npm start
